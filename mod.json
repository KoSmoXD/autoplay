{
  "geode": "5.11.1",
  "gd": {
    "android": "2.2081"
  },
  "id": "ollfx.autojump",
  "name": "AutoJump AI (Android)",
  "version": "v0.3.3",
  "developer": "oll.fx",
  "description": "Experimental autoplay with elevated-platform trajectory takeoff, saved jump positions and hazard groups.",
  "settings": {
    "enabled": {
      "name": "Enable AutoJump AI",
      "type": "bool",
      "default": false
    },
    "lookahead": {
      "name": "Base jump distance",
      "type": "float",
      "default": 47,
      "min": 8,
      "max": 130
    },
    "jump-solids": {
      "name": "Jump over small blocks",
      "type": "bool",
      "default": true
    },
    "learning": {
      "name": "Learn jump timing from deaths",
      "type": "bool",
      "default": true
    },
    "trajectory": {
      "name": "Show approximate trajectory",
      "type": "bool",
      "default": true
    },
    "platform-jumps": {
      "name": "Jump between same-height and higher blocks",
      "type": "bool",
      "default": true
    }
  }
}
